{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  // The dashboard's tasks live here, and only here: this file replaces the root's definition of a
  // task it names, so a root "@slideless/dashboard#build" entry is silently ignored (PRDCT-5175).
  // Every SvelteKit sync deletes and rewrites part of .svelte-kit/types, so two at once fail at
  // random (ENOENT on proxy+layout.ts, "Unexpected end of JSON input"). `sync` is the one sync the
  // checks wait for; typecheck and test only read what it wrote; `vite build` always runs a sync of
  // its own, so it waits for both readers instead of rewriting the files under them.
  "tasks": {
    "sync": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["^build", "sync"]
    },
    "typecheck": {
      "dependsOn": ["^build", "sync"]
    },
    "test": {
      "dependsOn": ["^build", "sync"]
    },
    "build": {
      "dependsOn": ["^build", "sync", "typecheck", "test"],
      "outputs": ["../server/public/**"]
    }
  }
}
