{
  "name": "@slideless/dashboard",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync",
    "build": "vite build",
    "dev": "vite dev",
    "typecheck": "rm -rf .svelte-kit/types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src",
    "test": "svelte-kit sync && vitest run --passWithNoTests",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@antasphere/chassis-contract": "workspace:*",
    "@slideless/contract": "workspace:*",
    "@slideless/sdk": "workspace:*",
    "better-auth": "1.6.33"
  },
  "devDependencies": {
    "@lucide/svelte": "^0.482.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "@tanstack/table-core": "^8.21.3",
    "autoprefixer": "^10.6.1",
    "bits-ui": "^1.4.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "postcss": "^8.5.28",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^0.3.28",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^0.2.1",
    "tailwindcss": "^3.4.18",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
