{
  "name": "@slideless/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "public"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --dir test/unit",
    "test:integration": "vitest run --dir test/integration",
    "drift:check": "bash scripts/check-auth-schema-drift.sh",
    "docs:env": "tsx scripts/generate-env-docs.ts && prettier --write ../../docs/reference/env-reference.md"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1102.0",
    "@aws-sdk/lib-storage": "^3.1102.0",
    "@better-auth/oauth-provider": "1.6.25",
    "@hono/mcp": "0.3.1",
    "@hono/node-server": "^1.14.0",
    "@hono/zod-openapi": "^1.5.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@slideless/contract": "workspace:*",
    "@slideless/db": "workspace:*",
    "better-auth": "1.6.25",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.8",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "pg-boss": "^10.4.2",
    "pino": "^9.7.0",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^7.4.0",
    "resend": "^6.18.1",
    "ulid": "^3.0.2",
    "yazl": "^3.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@better-auth/cli": "1.4.21",
    "@antasphere/slideless": "workspace:*",
    "@testcontainers/postgresql": "^11.0.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.3",
    "@types/yazl": "^3.3.1",
    "adm-zip": "^0.6.0",
    "pino-pretty": "^13.0.0",
    "testcontainers": "^11.14.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.5",
    "vitest": "^3.2.0"
  }
}
