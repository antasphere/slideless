# ── Required ────────────────────────────────────────────────────────────────
# The blessed install path is ./setup.sh — it generates every secret below.
# This file is for manual/reference installs. Set POSTGRES_PASSWORD to a real
# value: compose refuses to start while it is empty.
# Password for the bundled Postgres container (compose wires DATABASE_URL from it).
POSTGRES_PASSWORD=

# ── Recommended ─────────────────────────────────────────────────────────────
# Public origin of this instance. https:// enables Secure cookies behind TLS.
PUBLIC_BASE_URL=http://localhost:3000

# Session/JWKS secret (>=32 chars). Leave empty to auto-generate into the data
# volume on first boot (fine for a single replica; set explicitly for more).
AUTH_SECRET=

# Versioned API-key peppers — only needed when rotating secrets. Format:
# `<version>:<secret>` entries joined by `;`, secrets >=32 chars. Version 1
# defaults to AUTH_SECRET; when pinned here it MUST be the historical
# AUTH_SECRET value or every existing API key stops resolving. New keys mint
# under the highest version. Runbook: internal/security-runbooks.md.
# API_KEY_PEPPERS=

# ── Optional ────────────────────────────────────────────────────────────────
# Dedicated user-content origin for share links (docs/security/viewer-security-model.md).
# Unset = links live on PUBLIC_BASE_URL under CSP:sandbox (the proven-safe
# default). Set it to a second hostname fronting this same instance — one that
# carries no app cookies — for the ADR 012 separate-origin hardening.
# VIEWER_BASE_URL=https://usercontent.example.net

# De-dupe window (minutes) for share-link view counting: repeat opens of the
# same link from one browser inside this window count once (prefetch, reloads,
# mail scanners no longer inflate). 0 disables de-dupe (every entry GET counts).
# VIEW_DEDUPE_WINDOW_MINUTES=10

# Days of per-view share-link analytics events to keep (when a link was
# opened, referring site host, placement label, browser family — never IPs
# or full URLs). Nightly purge; 0 keeps events forever.
# VIEW_EVENTS_RETENTION_DAYS=90

# APP_PORT=3000
# LOG_LEVEL=info
# APP_IMAGE=ghcr.io/antasphere/slideless:latest

# Require a token for the first-boot setup call (recommended on public hosts).
# SETUP_TOKEN=

# Behind a reverse proxy you control (docs/self-hosting/reverse-proxy.md): trust the
# rightmost x-forwarded-for hop for client IPs (rate limits, audit).
# TRUST_PROXY=true

# Break-glass instance recovery (internal/security-runbooks.md). A signed-in user whose
# VERIFIED email is on this comma-separated list may claim workspace
# ownership or reset a member's 2FA via POST /api/v1/admin/break-glass/*.
# Machine credentials never qualify. Unset = the capability is fully dormant.
# SUPERADMIN_EMAILS=ops@example.com

# Nightly cleanup of orphaned users (accounts with NO workspace membership,
# e.g. setup-race losers): deleted once older than this many hours. Users
# with ANY membership — even deactivated — are never touched. 0 disables.
# ORPHAN_USER_RETENTION_HOURS=72

# Email: none (default — invitation links stay copyable), smtp, or resend.
# EMAIL_DRIVER=none
# SMTP_URL=smtps://user:pass@mail.example.com:465
# RESEND_API_KEY=
# EMAIL_FROM=Slideless <noreply@slideless.app>

# Shared rate-limit store for multi-replica deployments.
# REDIS_URL=redis://redis:6379

# Protect the Prometheus /metrics endpoint. /metrics is DISABLED (401) until
# this is set; scrapers then send `Authorization: Bearer <token>`. setup.sh
# generates one automatically.
# METRICS_TOKEN=

# OTLP/HTTP endpoint for trace export. Unset = no export (zero phone-home).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces

# Google social login.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# File storage: local (default; app_data volume) or s3 (MinIO/AWS/R2 —
# uncomment the minio service in docker-compose.yml for self-hosted S3).
# STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=http://minio:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# MAX_FILE_SIZE_MB=100

# General per-principal API quota: requests/minute for every authenticated
# principal (API key, OAuth token, session) plus a 1-second spike cap.
# 0 disables the general limiter (auth-surface limits always stay on).
# API_RATE_LIMIT_PER_MINUTE=600
# API_RATE_LIMIT_BURST=100

# ── Cloud edition (internal/federation.md) ──────────────────────────────────────
# Self-host installs NEVER set these. EDITION=cloud federates human login and
# org/membership truth to the Antasphere hub — read live AS EACH USER via
# their own SSO grant; there is no service key. The boot fails loudly if any
# HUB_* var below is missing. This instance's own OAuth resource URL is
# derived (<PUBLIC_BASE_URL>/mcp), never configured.
# EDITION=cloud
# HUB_ISSUER_URL=https://account.antasphere.com
# HUB_CLIENT_ID=tool-slideless-cloud
# HUB_CLIENT_SECRET=
# The hub-set SSO hint cookie the dashboard reads for silent auto-connect
# (never a security input). Defaults: name ant_sso_hint; domain = the issuer
# host minus its first label (account.antasphere.com → antasphere.com) — set
# these only on unusual topologies, and keep them in lockstep with the hub.
# HUB_HINT_COOKIE_NAME=ant_sso_hint
# HUB_HINT_COOKIE_DOMAIN=antasphere.com
# One-boot acknowledgement for changing EDITION on an already-set-up instance
# (the R7 guard refuses the flip otherwise). Unset it again after the boot.
# EDITION_CHANGE_ALLOWED=true
