{
  "name": "@slideless/cli",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "slideless": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@slideless/contract": "workspace:*",
    "@slideless/sdk": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "vitest": "^3.2.0"
  }
}
