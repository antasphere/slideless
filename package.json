{
  "name": "slideless",
  "private": true,
  "version": "0.5.0",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Self-hosted Slideless: one Docker image + Postgres, Hono API, SvelteKit dashboard, Better Auth, MCP endpoint",
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "pnpm": {
    "overrides": {
      "better-auth@1.6.22>@better-auth/core": "1.6.22",
      "@better-auth/oauth-provider@1.6.22>@better-auth/core": "1.6.22",
      "fast-uri@3": ">=3.1.5",
      "ip-address@10": ">=10.3.1",
      "nanoid@3": ">=3.3.18",
      "nanoid@5": ">=5.1.16",
      "postcss@8": ">=8.5.18"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-svelte": "^3.10.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.35.0",
    "svelte-eslint-parser": "^1.2.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0"
  }
}
